rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner() { return signedIn() && resource.data.ownerId == request.auth.uid; }
    function newOwner() { return signedIn() && request.resource.data.ownerId == request.auth.uid; }

    match /members/{id} {
      allow read, update, delete: if owner();
      allow create: if newOwner();
    }
    match /payments/{id} {
      allow read, update, delete: if owner();
      allow create: if newOwner();
    }
    match /settings/{id} {
      allow read, write: if signedIn() && id == request.auth.uid;
    }
  }
}
